# Replace with a long random key. Never commit real secrets.
PROOFLINE_API_KEY=replace-with-strong-random-secret
PROOFLINE_TENANT=default
# Alternatively: PROOFLINE_TENANT_KEYS={"acme":"secret-a","beta":"secret-b"}
PROOFLINE_DB=proofline.db
PROOFLINE_DEMO=1

# Optional read-only ERP providers. Tokens are configured ONLY on the server.
# Each access token must already have been granted through provider OAuth2.
# JSON example and setup: docs/integrations.md
PROOFLINE_ERP_CONNECTIONS={}

# Trusted public signing keys (Ed25519), scoped to tenant and key_id.
# JSON format: {"tenant":{"key-id":"BASE64_32_BYTE_PUBLIC_KEY"}}
PROOFLINE_TRUSTED_DOCUMENT_KEYS={}
